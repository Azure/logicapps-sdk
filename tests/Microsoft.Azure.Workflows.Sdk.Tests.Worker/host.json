{
  "version": "2.0",
  "extensions": {
    "workflow": {
      "settings": {
        "Runtime.CSharpScriptActionJob.RunInIsolatedWorker": true
      }
    }
  },
  "logging": {
    "logLevel": {
      "default": "Debug"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle.Workflows",
    "version": "[1.*, 2.0.0)"
  }
}

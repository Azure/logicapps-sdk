<Project Sdk="Azure.Functions.Sdk/1.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <WorkflowRepositoryConsumer>true</WorkflowRepositoryConsumer>
    <LogicAppFolderToPublish>$(MSBuildProjectDirectory)\lib\codeful</LogicAppFolderToPublish>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <ProjectReference Include="..\..\src\Microsoft.Azure.Workflows.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Link to shared Workflows from UnitTests project -->
    <Compile Include="..\Microsoft.Azure.Workflows.Sdk.UnitTests\Workflows\**\*.cs" Link="Workflows\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="connections.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="parameters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="ReplaceLanguageNetCore" AfterTargets="Build;Publish">
    <PropertyGroup>
      <WorkerConfigPath>$(PublishDir)/worker.config.json</WorkerConfigPath>
      <WorkerConfigPath Condition="!Exists('$(WorkerConfigPath)')">$(OutputPath)/worker.config.json</WorkerConfigPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(WorkerConfigPath)" Lines="$([System.IO.File]::ReadAllText($(WorkerConfigPath)).Replace('dotnet-isolated','dotnet'))" Overwrite="true" Condition="Exists('$(WorkerConfigPath)')"/>
  </Target>
  <Target Name="CopyToCodefulFolder" AfterTargets="Build;Publish" Condition="'$(LogicAppFolderToPublish)' != ''">
    <PropertyGroup>
      <SourcePath Condition="Exists('$(PublishDir)')">$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</SourcePath>
      <SourcePath Condition="!Exists('$(PublishDir)')">$([MSBuild]::EnsureTrailingSlash('$(OutputPath)'))</SourcePath>
    </PropertyGroup>
    <ItemGroup>
      <FilesToCopyCodeful Include="$(SourcePath)**\*"/>
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopyCodeful)" DestinationFolder="$(LogicAppFolderToPublish)\%(RecursiveDir)"/>
  </Target>
</Project>

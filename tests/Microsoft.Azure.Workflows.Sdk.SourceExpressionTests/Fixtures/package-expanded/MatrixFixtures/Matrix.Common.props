<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks Condition="'$(TargetFramework)' == ''">net8.0;net9.0</TargetFrameworks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion Condition="'$(TargetFramework)' == 'net8.0'">12</LangVersion>
    <LangVersion Condition="'$(TargetFramework)' != 'net8.0'">13</LangVersion>
    <StartupObject>FixtureEntry</StartupObject>
    <WorkflowFile Condition="'$(WorkflowFile)' == ''">$(MSBuildThisFileDirectory)Shared\Workflow.cs</WorkflowFile>
    <SdkPackageVersion Condition="'$(SdkPackageVersion)' == ''">1.0.0-preview.2</SdkPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Workflows.Sdk" Version="$(SdkPackageVersion)" />
    <Compile Include="$(MSBuildThisFileDirectory)Matrix\Program.cs" Link="Program.cs" />
    <Compile Include="$(WorkflowFile)" Link="Workflow.cs" />
    <None Include="$(WorkflowFixtureFile)" Condition="'$(WorkflowFixtureFile)' != ''"
          Link="Probe\workflow.json" CopyToPublishDirectory="PreserveNewest" />
    <WorkflowExpressionSchema Include="$(WorkflowSchemaFile)" Condition="'$(WorkflowSchemaFile)' != ''" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)ReferenceHelper\ReferenceHelper.csproj"
                      Condition="'$(UseReferenceHelper)' == 'true'">
      <Aliases Condition="'$(FixtureReferenceAliases)' != ''">$(FixtureReferenceAliases)</Aliases>
    </ProjectReference>
  </ItemGroup>
  <Target Name="RecordDesignTimeCompileItems" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' == 'true'">
    <WriteLinesToFile File="$(IntermediateOutputPath)design-time-inputs.txt"
                      Lines="@(Compile->'%(FullPath)')" Overwrite="true" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <InjectionRepositoryRoot Condition="'$(InjectionRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\</InjectionRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(InjectionRepositoryRoot)src\Build\Microsoft.Azure.Workflows.Sdk.Build\Microsoft.Azure.Workflows.Sdk.Build.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="$(InjectionRepositoryRoot)src\Build\ConnectorValidation.targets" />
  <Target Name="Protobuf_Compile" />
</Project>

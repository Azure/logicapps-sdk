<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);CS1591;CA2007;CS9113</NoWarn>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Microsoft Corporation</Authors>
    <Description>Microsoft Azure Logic Apps SDK</Description>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeWorkflowBuildTool</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Build\**\*.cs" />
    <None Update="buildTransitive\Microsoft.Azure.Workflows.Sdk.BuildTasks.targets" Pack="true" PackagePath="buildTransitive\Microsoft.Azure.Workflows.Sdk.BuildTasks.targets" />
    <None Update="buildTransitive\Microsoft.Azure.Workflows.Sdk.props" Pack="true" PackagePath="buildTransitive\Microsoft.Azure.Workflows.Sdk.props" />
    <None Update="buildTransitive\Microsoft.Azure.Workflows.Sdk.targets" Pack="true" PackagePath="buildTransitive\Microsoft.Azure.Workflows.Sdk.targets" />
    <ProjectReference Include="Build\Microsoft.Azure.Workflows.Sdk.Build\Microsoft.Azure.Workflows.Sdk.Build.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <Import Project="Build\ConnectorValidation.targets" />

  <Target Name="IncludeWorkflowBuildTool" DependsOnTargets="VerifyConnectorValidationAssembly">
    <MSBuild Projects="$(MSBuildProjectDirectory)\Build\Microsoft.Azure.Workflows.Sdk.Build\Microsoft.Azure.Workflows.Sdk.Build.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_WorkflowBuildToolAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_WorkflowBuildToolDirectory>@(_WorkflowBuildToolAssembly->'%(RootDir)%(Directory)')</_WorkflowBuildToolDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WorkflowBuildToolDirectory)Microsoft.Azure.Workflows.Sdk.Build.dll') or !Exists('$(_WorkflowBuildToolDirectory)Microsoft.Azure.Workflows.Sdk.Build.deps.json') or !Exists('$(_WorkflowBuildToolDirectory)Microsoft.Azure.Workflows.Sdk.Build.runtimeconfig.json')"
           Text="The workflow compiler must be built before packing the SDK. Build the SDK and its build-tool project before using --no-build." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_WorkflowBuildToolDirectory)**\*">
        <PackagePath>tools\workflow-build\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Rpc" Version="1.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
      <ExcludeFromStyleCop Include="**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Microsoft.Azure.Workflows.Sdk.ExpressionTests, </_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Microsoft.Azure.Workflows.Sdk.CSharpExpressionTests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.21.9" IncludeAssets="all" />
    <PackageReference Include="Grpc.Core.Api" Version="2.60.0" IncludeAssets="all" />
    <PackageReference Include="Grpc.Net.Client" Version="2.60.0" IncludeAssets="all" />
    <PackageReference Include="Grpc.Tools" Version="2.53.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Abstractions" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Grpc\Protos\IJobSessionService.proto" GrpcServices="Client" />
  </ItemGroup>
  
</Project>

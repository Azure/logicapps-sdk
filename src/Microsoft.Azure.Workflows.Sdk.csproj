<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);CS1591;CA2007;CS9113</NoWarn>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Microsoft Corporation</Authors>
    <Description>Microsoft Azure Logic Apps SDK</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Build\**\*.cs" />
    <ProjectReference Include="Build\Microsoft.Azure.Workflows.Sdk.Build\Microsoft.Azure.Workflows.Sdk.Build.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained" />
    <None Update="buildTransitive\*.props;buildTransitive\*.targets" Pack="true" PackagePath="buildTransitive\%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Rpc" Version="1.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="IncludeWorkflowCompiler" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="$(MSBuildProjectDirectory)\Build\Microsoft.Azure.Workflows.Sdk.Build\Microsoft.Azure.Workflows.Sdk.Build.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_WorkflowBuildTool" />
    </MSBuild>
    <PropertyGroup>
      <_WorkflowBuildDirectory>@(_WorkflowBuildTool->'%(RootDir)%(Directory)')</_WorkflowBuildDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WorkflowBuildDirectory)Microsoft.Azure.Workflows.Sdk.Build.runtimeconfig.json')"
           Text="Build the workflow compiler before packing the SDK." />
    <ItemGroup>
      <None Include="$(_WorkflowBuildDirectory)**\*" Pack="true" PackagePath="tools\workflow-build\%(RecursiveDir)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
      <ExcludeFromStyleCop Include="**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.21.9" IncludeAssets="all" />
    <PackageReference Include="Grpc.Core.Api" Version="2.60.0" IncludeAssets="all" />
    <PackageReference Include="Grpc.Net.Client" Version="2.60.0" IncludeAssets="all" />
    <PackageReference Include="Grpc.Tools" Version="2.53.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Abstractions" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Grpc\Protos\IJobSessionService.proto" GrpcServices="Client" />
  </ItemGroup>
  
</Project>
